PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/equipment
# 운영에서는 false로 두고 마이그레이션을 쓴다
DB_SYNC=true
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
# 개발용: 설정하면 SMS 없이 이 번호로 로그인된다 (production에서는 무시됨)
OTP_DEV_CODE=123456
# 운영자 로그인을 허용할 번호 (쉼표 구분)
ADMIN_PHONES=01000000000
# 배차 설정
OFFER_TIMEOUT_MS=15000
RADIUS_STEPS_KM=5,10,20
RADIUS_STEP_MS=120000
COMMISSION_RATE=0.05

# ── 바깥 서비스 연동 (비워 두면 개발용 동작으로 돌아간다) ──
# 이 서버를 바깥에서 부르는 주소 (카드 등록 후 돌아올 주소)
PUBLIC_URL=http://localhost:3000
# 인증번호 재발송 간격(초), 시간당 최대 요청, 최대 오입력
OTP_RESEND_SEC=30
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# 문자: 솔라피 https://console.solapi.com → API Key 관리. 발신번호는 솔라피에 등록된 번호
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_SENDER=

# 카드 자동결제: 토스페이먼츠 https://developers.tosspayments.com → API 키 (자동결제 계약 필요)
# test_ck_ / test_sk_ 로 시작하는 테스트 키면 실제 돈이 나가지 않는다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 푸시: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 (JSON의 값)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# 줄바꿈은 \n 으로 한 줄에
FCM_PRIVATE_KEY=

# 카카오: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# 주소 검색(로컬)과 길찾기(카카오모빌리티) 둘 다 이 키를 쓴다
KAKAO_REST_KEY=
KAKAO_ROUTE_CANDIDATES=5
